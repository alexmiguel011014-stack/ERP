# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o .env de verdade (já está no .gitignore).
# O app funciona normalmente sem nenhuma dessas variáveis configuradas —
# elas só habilitam integrações opcionais, com fallback manual quando ausentes.

# ---------- Pix (integracoes/pix/) ----------
# Sem nenhuma variável abaixo: o app gera QR Code Pix genérico (funciona com
# qualquer chave Pix, sem conta em provedor nenhum) e a confirmação de
# recebimento continua manual, como já era antes desta integração.

# Chave Pix da loja, usada no QR Code genérico (fallback sem provedor).
PIX_CHAVE=
PIX_NOME_RECEBEDOR=
PIX_CIDADE=

# Provedor pra confirmação automática de recebimento. Vazio = fallback manual.
# Único valor suportado hoje: "efi"
PIX_PROVIDER=

# Credenciais Efí (https://sejaefi.com.br/) — só necessárias se PIX_PROVIDER=efi
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERTIFICADO_PATH=
EFI_CERTIFICADO_SENHA=
EFI_CHAVE_PIX=
EFI_SANDBOX=true

# ---------- Fiscal / NF-e (integracoes/fiscal/) ----------
# Sem nenhuma variável abaixo: emissão pelo ERP fica indisponível — a loja
# segue rastreando manualmente (tela de Vendas > Nota fiscal > "Emitida por
# fora") até ter certificado A1 e conta no provedor prontos.

# Provedor de emissão. Vazio = emissão pelo ERP desabilitada (rastreamento
# manual continua funcionando). Único valor suportado hoje: "focusnfe"
FISCAL_PROVIDER=

# Credenciais Focus NFe (https://focusnfe.com.br/) — só necessárias se FISCAL_PROVIDER=focusnfe
FOCUSNFE_TOKEN=
FOCUSNFE_CNPJ_EMITENTE=
# "producao" usa a API real; qualquer outro valor (ou vazio) usa homologação.
FOCUSNFE_AMBIENTE=homologacao
